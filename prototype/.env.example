MLFLOW_TRACKING_URI=http://localhost:5000
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+psycopg://mlops:mlops@localhost:5432/mlops
API_URL=http://localhost:9696
# Agent Retrain : clé Groq (facultative) pour qu'un LLM rédige l'explication de ses décisions ;
# vide = message écrit par le code
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b

# --- Discord (facultatif, voir README « Alertes et boutons sur Discord ») ---
# Jeton du bot (Discord Developer Portal > Bot > Reset Token) ; vide = pas de Discord
DISCORD_BOT_TOKEN=
# Identifiants des salons (mode développeur, clic droit sur le salon > Copier l'identifiant)
DISCORD_ALERTS_CHANNEL_ID=
DISCORD_AGENTS_CHANNEL_ID=
# Mention en tête des alertes et des questions, ex. @here (vide = aucune)
DISCORD_ALERT_MENTION=

# --- docker compose (lus au lancement de `docker compose up`) ---
# Port de l'interface sur le PC : mettre 8090 si 8080 est déjà pris (par exemple par Oracle)
ORCHESTRATOR_HOST_PORT=8080
# Ollama vu depuis les conteneurs (par défaut : Ollama lancé sur le PC)
# OLLAMA_URL_DOCKER=http://host.docker.internal:11434
